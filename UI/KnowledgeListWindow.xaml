<Window x:Class="Gravity.UI.KnowledgeListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Knowledge"
        Height="500" Width="800"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Master Side: List of Knowledge Items -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Knowledge Base" 
                       FontSize="18" FontWeight="Bold" 
                       Margin="0,0,0,10" HorizontalAlignment="Left"/>
            <ListBox x:Name="KnowledgeListBox" 
                     Grid.Row="1" 
                     FontSize="14" 
                     SelectionChanged="KnowledgeListBox_SelectionChanged" />
        </Grid>

        <!-- Detail Side: Content View -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Details" 
                       FontSize="18" FontWeight="Bold" 
                       Margin="0,0,0,10" HorizontalAlignment="Left"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="KnowledgeDetailText" 
                           FontSize="14" 
                           TextWrapping="Wrap" 
                           Foreground="#333333" 
                           Text="Select an item from the list to view its details." />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>