<?xml version="1.0"?>
<Obfuscator>
  <Var name="InPath" value="bin\Release\net10.0-windows\publish" />
  <Var name="OutPath" value="bin\Release\net10.0-windows\publish\obfuscated" />
  <Module file="$(InPath)\Gravity.dll" />
  <OutputDirectory>$(OutPath)</OutputDirectory>
  <KeepPublicApi>true</KeepPublicApi>
  <KeepDebugSymbols>false</KeepDebugSymbols>
  <RenameProperties>true</RenameProperties>
  <RenameEvents>true</RenameEvents>
  <RenameFields>true</RenameFields>
  <RenameMethods>true</RenameMethods>
  <RenameNamespaces>true</RenameNamespaces>
  <Skip>
    <Type name="Gravity.Program" />
  </Skip>
</Obfuscator>